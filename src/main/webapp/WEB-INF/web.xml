<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <filter>
        <filter-name>UserAuthAccessFilter</filter-name>
        <filter-class>lk.jiat.calivon.middleware.UserAuthAccessFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>UserAuthAccessFilter</filter-name>
        <url-pattern>/my-account.html</url-pattern>
        <url-pattern>/wishlist.html</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AdminAuthAccessFilter</filter-name>
        <filter-class>lk.jiat.calivon.middleware.AdminAuthAccessFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminAuthAccessFilter</filter-name>
        <url-pattern>/admin-account.html</url-pattern>
    </filter-mapping>
    
</web-app>